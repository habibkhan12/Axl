# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-dev/
/out/

# runtime artifacts (dues captcha-worker browser profile, tooling caches)
/.captcha-profile/
/.dues-browser-profile/
/.asr-cache/
/.asr-tmp/
/.freebuff/

# production
/build

# misc
.DS_Store
*.pem

# build/runtime logs
*.log
*.err

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
